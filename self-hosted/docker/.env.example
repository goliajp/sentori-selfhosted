# Sentori self-hosted configuration.
#
#   cp .env.example .env    # then set the three values below
#
# Secret-bearing variables also accept a `_FILE` variant naming a
# mounted secret file (SENTORI_SMTP_PASS_FILE, ...). Direct env
# wins when both are set.

# ── required ────────────────────────────────────────────────

# Database password (the compose file wires it into the DSN).
POSTGRES_PASSWORD=

# The owner account. Reconciled on every boot: changing the email
# here renames the owner. If you leave SENTORI_OWNER_PASSWORD
# empty, the first boot generates one and prints it to the log:
#   docker compose logs sentori | grep password
SENTORI_OWNER_EMAIL=

# Public origin of this instance — used in email links and shown
# to SDK users. With a reverse proxy, the https origin.
SENTORI_BASE_URL=http://localhost:8080

# ── optional ────────────────────────────────────────────────

# Owner password. Only used when the account doesn't exist yet;
# it never overwrites a live password on restart.
SENTORI_OWNER_PASSWORD=

# SMTP — leave SENTORI_SMTP_HOST empty to run without email.
# Everything else works; the Settings page shows the channel as
# not configured.
SENTORI_SMTP_HOST=
SENTORI_SMTP_PORT=587
SENTORI_SMTP_USER=
SENTORI_SMTP_PASS=
SENTORI_SMTP_FROM=
# starttls | tls | plain
SENTORI_SMTP_TLS=starttls

# ── advanced (defaults are fine) ────────────────────────────

# Symbol-artifact retention: keep sourcemaps/dSYMs/mappings for the
# newest N releases per project; older ones (and any blob nothing
# references) are reclaimed daily. 0 disables. Release history
# itself is never deleted — regression anchoring keeps working.
#SENTORI_ARTIFACT_KEEP_RELEASES=20

# Event retention: raw events and their attachments (replays,
# screenshots) older than N days are removed daily. Issues — the
# aggregates you triage — keep their counters, timelines and
# regression anchors forever. 0 disables.
#SENTORI_EVENT_RETENTION_DAYS=90

# Host port for the dashboard + ingest.
#SENTORI_PORT=8080
# Pin an image version instead of latest.
#SENTORI_VERSION=latest
#RUST_LOG=info,sqlx=warn
